# ── NexusAI CAP ──────────────────────────────────────────────────────────
# Copy to .env and fill in the keys you use. Never commit .env.
# The dashboard and CLI work without any keys using the free providers
# (ollama for local, g4f / pollinations for free cloud).

# Core settings
NEXUSAI_PROVIDER=auto            # auto | openai | anthropic | gemini | groq | ollama | g4f | ...
NEXUSAI_MODEL=                  # override default model for the provider
NEXUSAI_VERBOSE=true
NEXUSAI_LOG_LEVEL=INFO

# Provider API keys — fill only the ones you use (dummy placeholders shown)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key
GOOGLE_API_KEY=your-google-key
GROQ_API_KEY=gsk_your-groq-key
MISTRAL_API_KEY=your-mistral-key
COHERE_API_KEY=your-cohere-key
TOGETHER_API_KEY=your-together-key
FIREWORKS_API_KEY=your-fireworks-key
DEEPSEEK_API_KEY=your-deepseek-key
HUGGINGFACE_API_KEY=hf_your-huggingface-key
PERPLEXITY_API_KEY=pplx-your-perplexity-key
XAI_API_KEY=xai-your-xai-key
CEREBRAS_API_KEY=csk-your-cerebras-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Web dashboard
PORT=8080
